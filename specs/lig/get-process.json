{
  "name": "get-process",
  "description": "List running processes (ps, gps)",
  "options": [
    {
      "name": "-Name",
      "description": "Process names",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-Id",
      "description": "Process ids",
      "args": {
        "name": "id"
      }
    },
    {
      "name": "-Module",
      "description": "Include loaded modules"
    },
    {
      "name": "-FileVersionInfo",
      "description": "Include file version information"
    },
    {
      "name": "-IncludeUserName",
      "description": "Include the owner"
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "name",
    "isOptional": true
  }
}
