{
  "name": "test-path",
  "description": "Whether a path exists",
  "options": [
    {
      "name": "-Path",
      "description": "Path of the item",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-LiteralPath",
      "description": "Path, taken literally (no wildcards)",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-PathType",
      "description": "What it must be",
      "args": {
        "name": "type",
        "suggestions": [
          "Any",
          "Container",
          "Leaf"
        ]
      }
    },
    {
      "name": "-IsValid",
      "description": "Only check the syntax"
    },
    {
      "name": "-Filter",
      "description": "Filter in the provider's format (e.g. *.txt)",
      "args": {
        "name": "filter"
      }
    },
    {
      "name": "-Include",
      "description": "Only these items (wildcards)",
      "args": {
        "name": "pattern"
      }
    },
    {
      "name": "-Exclude",
      "description": "Skip these items (wildcards)",
      "args": {
        "name": "pattern"
      }
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "path",
    "template": "filepaths"
  }
}
