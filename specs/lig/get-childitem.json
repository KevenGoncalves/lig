{
  "name": "get-childitem",
  "description": "List items in a folder (ls, dir, gci)",
  "options": [
    {
      "name": "-Path",
      "description": "Path of the item",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-LiteralPath",
      "description": "Path, taken literally (no wildcards)",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-Filter",
      "description": "Filter in the provider's format (e.g. *.txt)",
      "args": {
        "name": "filter"
      }
    },
    {
      "name": "-Include",
      "description": "Only these items (wildcards)",
      "args": {
        "name": "pattern"
      }
    },
    {
      "name": "-Exclude",
      "description": "Skip these items (wildcards)",
      "args": {
        "name": "pattern"
      }
    },
    {
      "name": "-Recurse",
      "description": "Include subfolders"
    },
    {
      "name": "-Depth",
      "description": "How many levels to recurse",
      "args": {
        "name": "depth"
      }
    },
    {
      "name": "-Force",
      "description": "Include hidden and read-only items, or overwrite"
    },
    {
      "name": "-Name",
      "description": "Only the names"
    },
    {
      "name": "-File",
      "description": "Only files"
    },
    {
      "name": "-Directory",
      "description": "Only folders"
    },
    {
      "name": "-Hidden",
      "description": "Only hidden items"
    },
    {
      "name": "-ReadOnly",
      "description": "Only read-only items"
    },
    {
      "name": "-System",
      "description": "Only system items"
    },
    {
      "name": "-Attributes",
      "description": "Items with these attributes",
      "args": {
        "name": "attributes",
        "suggestions": [
          "Archive",
          "Compressed",
          "Directory",
          "Encrypted",
          "Hidden",
          "ReadOnly",
          "ReparsePoint",
          "System"
        ]
      }
    },
    {
      "name": "-FollowSymlink",
      "description": "Follow links when recursing"
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "path",
    "isOptional": true,
    "template": "filepaths"
  }
}
