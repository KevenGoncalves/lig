      "args": {
        "name": "color",
        "suggestions": [
          "Black",
          "DarkBlue",
          "DarkGreen",
          "DarkCyan",
          "DarkRed",
          "DarkMagenta",
          "DarkYellow",
          "Gray",
          "DarkGray",
          "Blue",
          "Green",
