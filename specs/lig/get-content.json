{
  "name": "get-content",
  "description": "Show a file's contents (cat, gc, type)",
  "options": [
    {
      "name": "-Path",
      "description": "Path of the item",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-LiteralPath",
      "description": "Path, taken literally (no wildcards)",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-Tail",
      "description": "Only the last lines",
      "args": {
        "name": "lines"
      }
    },
    {
      "name": "-TotalCount",
      "description": "Only the first lines",
      "args": {
        "name": "lines"
      }
    },
    {
      "name": "-Head",
      "description": "Only the first lines",
      "args": {
        "name": "lines"
      }
    },
    {
      "name": "-Wait",
      "description": "Keep reading lines as they are added"
    },
    {
      "name": "-Raw",
      "description": "One string, newlines included"
    },
    {
      "name": "-Encoding",
      "description": "Text encoding",
      "args": {
        "name": "encoding",
        "suggestions": [
          "utf8",
          "utf8NoBOM",
          "utf8BOM",
          "ascii",
          "unicode",
          "utf32",
          "bigendianunicode",
          "oem",
          "default"
        ]
      }
    },
    {
      "name": "-Delimiter",
      "description": "Split at this text instead of newlines",
      "args": {
        "name": "text"
      }
    },
    {
      "name": "-Force",
      "description": "Include hidden and read-only items, or overwrite"
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "path",
    "template": "filepaths"
  }
}
