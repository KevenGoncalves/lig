{
  "name": "push-location",
  "description": "Save the current folder and change to another (pushd)",
  "options": [
    {
      "name": "-Path",
      "description": "Folder to go to",
      "args": {
        "name": "path",
        "template": "folders"
      }
    },
    {
      "name": "-PassThru",
      "description": "Output the item it works on"
    },
    {
      "name": "-StackName",
      "description": "Location stack to use",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "path",
    "isOptional": true,
    "template": "folders"
  }
}
