{
  "name": "copy-item",
  "description": "Copy files and folders (cp, copy)",
  "options": [
    {
      "name": "-Path",
      "description": "Path of the item",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-LiteralPath",
      "description": "Path, taken literally (no wildcards)",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-Destination",
      "description": "Where to copy to",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-Recurse",
      "description": "Include subfolders"
    },
    {
      "name": "-Force",
      "description": "Include hidden and read-only items, or overwrite"
    },
    {
      "name": "-Container",
      "description": "Keep the folder structure"
    },
    {
      "name": "-Filter",
      "description": "Filter in the provider's format (e.g. *.txt)",
      "args": {
        "name": "filter"
      }
    },
    {
      "name": "-Include",
      "description": "Only these items (wildcards)",
      "args": {
        "name": "pattern"
      }
    },
    {
      "name": "-Exclude",
      "description": "Skip these items (wildcards)",
      "args": {
        "name": "pattern"
      }
    },
    {
      "name": "-PassThru",
      "description": "Output the item it works on"
    },
    {
      "name": "-WhatIf",
      "description": "Show what would happen without doing it"
    },
    {
      "name": "-Confirm",
      "description": "Ask before doing it"
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "path",
    "template": "filepaths"
  }
}
