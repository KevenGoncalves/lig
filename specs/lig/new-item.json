{
  "name": "new-item",
  "description": "Create a file, folder or link (ni)",
  "options": [
    {
      "name": "-Path",
      "description": "Path of the item",
      "args": {
        "name": "path",
        "template": "filepaths"
      }
    },
    {
      "name": "-Name",
      "description": "Name of the new item",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-ItemType",
      "description": "What to create",
      "args": {
        "name": "type",
        "suggestions": [
          "File",
          "Directory",
          "SymbolicLink",
          "Junction",
          "HardLink"
        ]
      }
    },
    {
      "name": "-Value",
      "description": "Contents, or the link's target",
      "args": {
        "name": "value",
        "template": "filepaths"
      }
    },
    {
      "name": "-Force",
      "description": "Include hidden and read-only items, or overwrite"
    },
    {
      "name": "-WhatIf",
      "description": "Show what would happen without doing it"
    },
    {
      "name": "-Confirm",
      "description": "Ask before doing it"
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "path",
    "isOptional": true,
    "template": "filepaths"
  }
}
