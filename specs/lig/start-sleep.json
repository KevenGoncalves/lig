{
  "name": "start-sleep",
  "description": "Wait (sleep)",
  "options": [
    {
      "name": "-Seconds",
      "description": "How long",
      "args": {
        "name": "seconds"
      }
    },
    {
      "name": "-Milliseconds",
      "description": "How long",
      "args": {
        "name": "ms"
      }
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
