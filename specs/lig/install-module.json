{
  "name": "install-module",
  "description": "Install a module from the PowerShell Gallery",
  "options": [
    {
      "name": "-Name",
      "description": "Module names",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-Scope",
      "description": "Who gets it",
      "args": {
        "name": "scope",
        "suggestions": [
          "CurrentUser",
          "AllUsers"
        ]
      }
    },
    {
      "name": "-RequiredVersion",
      "description": "This version",
      "args": {
        "name": "version"
      }
    },
    {
      "name": "-AllowClobber",
      "description": "Replace commands other modules have"
    },
    {
      "name": "-AllowPrerelease",
      "description": "Prerelease versions too"
    },
    {
      "name": "-Force",
      "description": "Include hidden and read-only items, or overwrite"
    },
    {
      "name": "-WhatIf",
      "description": "Show what would happen without doing it"
    },
    {
      "name": "-Confirm",
      "description": "Ask before doing it"
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "name"
  }
}
