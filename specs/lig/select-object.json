{
  "name": "select-object",
  "description": "Pick properties or items (select)",
  "options": [
    {
      "name": "-Property",
      "description": "Properties to keep",
      "args": {
        "name": "names"
      }
    },
    {
      "name": "-ExpandProperty",
      "description": "Output this property's value",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-First",
      "description": "The first items",
      "args": {
        "name": "count"
      }
    },
    {
      "name": "-Last",
      "description": "The last items",
      "args": {
        "name": "count"
      }
    },
    {
      "name": "-Skip",
      "description": "Skip items",
      "args": {
        "name": "count"
      }
    },
    {
      "name": "-Unique",
      "description": "Drop duplicates"
    },
    {
      "name": "-ErrorAction",
      "description": "What to do on a non-terminating error",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-WarningAction",
      "description": "What to do on a warning",
      "args": {
        "name": "action",
        "suggestions": [
          "Continue",
          "Stop",
          "SilentlyContinue",
          "Ignore",
          "Inquire"
        ]
      }
    },
    {
      "name": "-Verbose",
      "description": "Show detailed progress"
    },
    {
      "name": "-Debug",
      "description": "Show debugging messages"
    },
    {
      "name": "-ErrorVariable",
      "description": "Store errors in this variable",
      "args": {
        "name": "name"
      }
    },
    {
      "name": "-OutVariable",
      "description": "Store the output in this variable",
      "args": {
        "name": "name"
      }
    }
  ],
  "args": {
    "name": "property",
    "isOptional": true
  }
}
